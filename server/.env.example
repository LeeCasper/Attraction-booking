# ===== 服务 =====
PORT=3000
NODE_ENV=development

# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123456
DB_DATABASE=attraction_booking

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ===== JWT =====
JWT_SECRET=change-me-to-a-random-32+-chars-secret
JWT_EXPIRES_IN=8h

# ===== 凭证签名(动态二维码 §5.1) =====
CRED_SECRET=change-me-credential-hmac-secret-v1
CRED_SECRET_VERSION=1

# ===== 微信小程序 =====
WX_APPID=
WX_APP_SECRET=

# ===== 微信支付 V3 =====
WXPAY_MCHID=
WXPAY_APPID=
WXPAY_SERIAL_NO=          # 商户API证书序列号
WXPAY_PRIVATE_KEY_PATH=   # 商户API私钥 apiclient_key.pem
WXPAY_NOTIFY_URL=https://your-domain/pay/wx/notify
WXPAY_REFUND_NOTIFY_URL=https://your-domain/pay/wx/refund/notify

# ===== 安全 =====
IDCARD_HASH_SALT=change-me-idcard-hash-salt
AES_KEY=change-me-32-bytes-aes-256-gcm-key
