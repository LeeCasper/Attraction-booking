# ===== 服务 =====
PORT=3000
NODE_ENV=development

# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123456
DB_DATABASE=attraction_booking

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ===== JWT =====
JWT_SECRET=change-me-to-a-random-32+-chars-secret
JWT_EXPIRES_IN=8h

# ===== 凭证签名(动态二维码 §5.1) =====
CRED_SECRET=change-me-credential-hmac-secret-v1
CRED_SECRET_VERSION=1
# 轮换期旧密钥（滚动换密钥时填，例如从 v1 换到 v2：VERSION=2、PREV_VERSION=1、PREV=旧值）
CRED_SECRET_PREV=
CRED_SECRET_PREV_VERSION=

# ===== 闸机互信 =====
# 单次核验允许的时钟偏移（秒），防重放窗口
GATE_SIGN_TOLERANCE_SECONDS=60

# ===== 微信小程序 =====
WX_APPID=
WX_APP_SECRET=
# 本地联调必须为 true（本地拿不到合法 wx.login code）；上线前改 false
WX_MOCK=true

# ===== 微信支付 V3 =====
WXPAY_MCHID=
WXPAY_APPID=
WXPAY_SERIAL_NO=          # 商户API证书序列号
WXPAY_PRIVATE_KEY_PATH=   # 商户API私钥 apiclient_key.pem 的绝对路径
WXPAY_API_V3_KEY=         # APIv3 密钥（回调报文解密用）
WXPAY_NOTIFY_URL=https://your-domain/pay/wx/notify
WXPAY_REFUND_NOTIFY_URL=https://your-domain/pay/wx/refund/notify
# 本地联调：无商户证书时保持 true（模拟下单/回调），上线前改为 false
WXPAY_MOCK=true
PAY_TIMEOUT_MINUTES=15

# ===== 安全 =====
IDCARD_HASH_SALT=change-me-idcard-hash-salt
AES_KEY=change-me-32-bytes-aes-256-gcm-key
