# ===== 服务 =====
PORT=3000

# 业务时区（IANA 名）。「今天/昨天」这类日历日按它算 ——
# 必须与 MySQL 的 --default-time-zone（+08:00）和部署主机时区一致。
# ⚠️ @Cron 的触发时刻只认默认值（装饰器在 .env 加载前求值），改这里不会改 cron 时区。
BUSINESS_TZ=Asia/Shanghai
NODE_ENV=development

# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123456
DB_DATABASE=attraction_booking

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ===== JWT =====
JWT_SECRET=change-me-to-a-random-32+-chars-secret
JWT_EXPIRES_IN=8h

# ===== 凭证签名(动态二维码 §5.1) =====
CRED_SECRET=change-me-credential-hmac-secret-v1
CRED_SECRET_VERSION=1
# 轮换期旧密钥（滚动换密钥时填，例如从 v1 换到 v2：VERSION=2、PREV_VERSION=1、PREV=旧值）
CRED_SECRET_PREV=
CRED_SECRET_PREV_VERSION=

# ===== 闸机互信 =====
# 单次核验允许的时钟偏移（秒），防重放窗口
GATE_SIGN_TOLERANCE_SECONDS=60

# ===== 微信小程序 =====
WX_APPID=
WX_APP_SECRET=
# 本地联调必须为 true（本地拿不到合法 wx.login code）；上线前改 false
WX_MOCK=true

# ===== 微信支付 V3 =====
WXPAY_MCHID=
WXPAY_APPID=
WXPAY_SERIAL_NO=          # 商户API证书序列号
WXPAY_PRIVATE_KEY_PATH=   # 商户API私钥 apiclient_key.pem 的绝对路径
WXPAY_API_V3_KEY=         # APIv3 密钥（回调报文解密用）
WXPAY_NOTIFY_URL=https://your-domain/pay/wx/notify
WXPAY_REFUND_NOTIFY_URL=https://your-domain/pay/wx/refund/notify
# 本地联调：无商户证书时保持 true（模拟下单/回调），上线前改为 false
WXPAY_MOCK=true
PAY_TIMEOUT_MINUTES=15

# ===== 天气（首页 banner 那一行）=====
# 「用哪家、哪个城市、缓存多久」不在这里 —— 在后台「系统管理 → 参数配置 → weather」里改。
# 这里只放密钥：两份都留着，所以后台切换数据源不用登服务器改配置。
QWEATHER_KEY=             # 和风天气 key（provider=qweather 时用）
AMAP_KEY=                 # 高德开放平台 key（provider=amap 时用）
# 覆盖上游域名（留空 = 用代码里的默认值 devapi.qweather.com / restapi.amap.com）：
#   - 和风新版账号给的是**专属域名**（形如 xxx.re.qweatherapi.com），必须用它
#   - 自测：与一个非空的 QWEATHER_KEY 一起指向本地 stub，就能离线跑 smoke:config
#     的 3 条上游断言（脚本自己会起 stub，用哪个端口看这里填什么）
WEATHER_API_BASE=
# 上游超时（毫秒）。它串在 platform/settings 上，别调得太大；2500 是为了容下
# 冷启动/走代理那一次（启动时已经预热一次，只有缓存过期后的第一位访客会碰到）
WEATHER_TIMEOUT_MS=2500

# ===== 安全 =====
IDCARD_HASH_SALT=change-me-idcard-hash-salt
AES_KEY=change-me-32-bytes-aes-256-gcm-key
