{
  "name": "attraction-booking-server",
  "version": "1.0.0",
  "description": "景区预约管理及门禁联动系统服务端",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec \"ts-node src/main.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "seed": "ts-node --transpile-only scripts/seed.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:order": "node scripts/smoke-order.mjs",
    "smoke:gate": "node scripts/smoke-gate.mjs",
    "smoke:m4": "node scripts/smoke-m4.mjs",
    "loadtest:booking": "k6 run loadtest/booking.js",
    "loadtest:oversell": "k6 run loadtest/oversell.js",
    "loadtest:gate": "k6 run loadtest/gate.js",
    "lint": "tsc --noEmit",
    "smoke:visitor": "node scripts/smoke-visitor.mjs",
    "smoke:date": "ts-node --transpile-only scripts/smoke-date.ts",
    "smoke:config": "ts-node --transpile-only scripts/smoke-config.ts",
    "backfill:credential-no": "ts-node --transpile-only scripts/backfill-credential-no.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "mysql2": "^3.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
