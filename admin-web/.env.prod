# backend service base url, prod environment
# 生产由 Nginx 同源反向代理 /api 到 Node 服务
VITE_SERVICE_BASE_URL=/api

# other backend service base url, prod environment
VITE_OTHER_SERVICE_BASE_URL= `{}`

# 生产部署在 https://res.artaides.com/admin/ 下（部署流程见 docs/部署流程.md）——
# base 必须是 /admin/，否则构建出来的静态资源路径是 /assets/...，从子路径访问会 404。
# 开发（vite --mode test）读的是 .env 里的 `/`，不受影响。
VITE_BASE_URL=/admin/
