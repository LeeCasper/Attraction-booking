# dependencies
node_modules/

# build
dist/
unpackage/
*.local

# 手工部署时留下的打包产物（docker save / tar 出来的镜像或整包），不要进仓库
server/*.tar

# env & secrets
.env
*.pem
*.key
!deploy/**/*.example
# 闸机模拟器本地配置（含闸机密钥）
gate-simulator/config.json

# 数据库备份产物
backups/

# 压测产物（k6 handleSummary 落盘的原始指标）
server/loadtest/results/

# logs
logs/
*.log
npm-debug.log*

# os / editor
.DS_Store
.idea/
.vscode/

# 后台上传的图片（运行时产物，不入库）
server/uploads/
