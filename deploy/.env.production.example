# =============================================================================
# 生产环境变量 —— 复制成 `deploy/.env` 再改（`.env` 被 gitignore，不会进仓库）
#
#   cp deploy/.env.production.example deploy/.env
#   # 改下面标了「必改」的几项，尤其三个密钥
#   chmod 600 deploy/.env
#
# 三个密钥怎么生成（每个都单独生成，别复用）：
#   openssl rand -base64 48     # JWT_SECRET
#   openssl rand -base64 48     # CRED_SECRET（动态二维码签名，改了等于作废历史凭证）
#   openssl rand -hex 32        # IDCARD_HASH_SALT（改了会导致限购/黑名单比对不上历史记录）
#   openssl rand -base64 32     # AES_KEY（32 字节；改了**已加密的证件号将无法解密**）
# ⚠️ AES_KEY 与 IDCARD_HASH_SALT 一旦上线就**不要改**：前者解不出存量密文，后者让
#    同一张身份证算出不同的哈希（限购会被绕过）。换它们要写迁移脚本。
# =============================================================================

# ===== 服务 =====
PORT=3000
# 与 MySQL 的 --default-time-zone、宿主机时区三者必须一致（见 CLAUDE.md 约束 11）
BUSINESS_TZ=Asia/Shanghai
NODE_ENV=production
# API 发布到宿主机的哪个端口（nginx 反代到这里）
API_PORT=3000

# ===== 数据库 =====
# ⚠️ 这两行要写进 deploy/.env 的**顶层**：compose 用它做变量替换（MySQL 容器的 root 密码），
#    同时 api 容器也读同一份（DB_HOST 被 compose 覆盖成服务名 mysql）
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=必改_换成一串随机密码
DB_DATABASE=attraction_booking

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379

# ===== JWT =====
JWT_SECRET=必改_openssl_rand_base64_48
JWT_EXPIRES_IN=8h

# ===== 凭证签名（动态二维码，见技术方案 §5.1）=====
CRED_SECRET=必改_openssl_rand_base64_48
CRED_SECRET_VERSION=1
CRED_SECRET_PREV=
CRED_SECRET_PREV_VERSION=

# ===== 闸机互信 =====
GATE_SIGN_TOLERANCE_SECONDS=60

# ===== 微信小程序 =====
# ⚠️⚠️ 现阶段留 true 只适合**内测**：mock 登录意味着**任何人**拿任意 code 就能换到 token、
#      调小程序端全部接口（下单、退款…）。所以这个域名先别往外发、别放真实用户数据。
#      拿到真实 AppID/Secret 后改成 false，并重新走一遍小程序登录联调。
WX_APPID=
WX_APP_SECRET=
WX_MOCK=true

# ===== 微信支付 V3 =====
WXPAY_MCHID=
WXPAY_APPID=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=/app/certs/apiclient_key.pem
WXPAY_API_V3_KEY=
# 回调必须是**公网 HTTPS**，且路径不在 /api 前缀下（main.ts 里 setGlobalPrefix 排除了它们）
WXPAY_NOTIFY_URL=https://res.artaides.com/pay/wx/notify
WXPAY_REFUND_NOTIFY_URL=https://res.artaides.com/pay/wx/refund/notify
# ⚠️ 同上：true = 支付/退款全走模拟（不扣钱也不进账），只适合内测
WXPAY_MOCK=true
PAY_TIMEOUT_MINUTES=15

# ===== 天气（首页 banner 那一行）=====
# 「用哪家、哪个城市、缓存多久」在后台「系统管理 → 参数配置 → weather」里改，不在这里。
# 这里只放密钥；两份都留着 ⇒ 后台切换数据源不用改这个文件、也不用重启。
# 不配 = 首页不显示天气那一行（这是默认行为，不会显示假数据）。
QWEATHER_KEY=
AMAP_KEY=
# 覆盖上游域名：和风新版账号给的是**专属域名**（形如 xxx.re.qweatherapi.com），必须填它
WEATHER_API_BASE=
# 上游超时（毫秒）。它串在小程序首屏要读的 platform/settings 上，别调大
WEATHER_TIMEOUT_MS=1500

# ===== 安全 =====
IDCARD_HASH_SALT=必改_openssl_rand_hex_32
AES_KEY=必改_openssl_rand_base64_32
